# ==========================================
# NEXUS ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=Nexus
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector)
# Example for local: postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
# Example for Neon/Railway: postgresql+asyncpg://user:password@host/nexus?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
# Synchronous DB URL for Alembic migrations & Celery sync tasks
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus

# Redis (Queue & Cache)
REDIS_URL=redis://localhost:6339/0

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=nexus_super_secret_dev_key_change_in_production_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings
# Options: local (sentence-transformers), gemini
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Provider for Resume PDFs
# Options: local, supabase, s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/resumes

# Media Generation Providers
# Video: HeyGen or D-ID
HEYGEN_API_KEY=
DID_API_KEY=
# Audio Fallback: ElevenLabs
ELEVENLABS_API_KEY=

# Pipeline Versions (Invalidates caches when incremented)
EXTRACTOR_VERSION=1.0.0
EMBEDDING_VERSION=1.0.0
MATCH_EXPLANATION_VERSION=1.0.0
BRIEFING_PROMPT_VERSION=1.0.0

# Optional Observability
SENTRY_DSN=
